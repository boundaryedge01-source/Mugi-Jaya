rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Form di website hanya boleh MENAMBAH data ke koleksi "leads".
    // Membaca, mengubah, dan menghapus ditutup. Admin membaca lewat Firebase Console.
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly([
          'nama', 'telepon', 'luasMeter', 'jumlahRuangan', 'butuhDesain',
          'estimasiTotal', 'paketRenovasi', 'sumber', 'createdAt'
        ])
        && request.resource.data.nama is string
        && request.resource.data.nama.size() >= 2
        && request.resource.data.nama.size() <= 80
        && request.resource.data.telepon is string
        && request.resource.data.telepon.size() >= 9
        && request.resource.data.telepon.size() <= 16
        && request.resource.data.luasMeter is number
        && request.resource.data.luasMeter >= 0
        && request.resource.data.luasMeter <= 100000
        && request.resource.data.jumlahRuangan is int
        && request.resource.data.jumlahRuangan >= 0
        && request.resource.data.jumlahRuangan <= 200
        && request.resource.data.butuhDesain is bool
        && request.resource.data.estimasiTotal is number
        && request.resource.data.paketRenovasi is bool
        && request.resource.data.sumber == 'website'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
